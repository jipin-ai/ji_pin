{
  "name": "admin-panel",
  "phase": "tasks",
  "created": "2026-05-02T00:10:00+08:00",
  "language": "zh",
  "brief": "BidSmart 管理面板：用户 CRUD、角色管理、密钥轮换、数据导出/导入、审计日志",
  "version": "0.7.7",
  "environment": "ECS 8.219.137.176:/root/bidsmart",
  "modules": [
    {
      "name": "admin-router",
      "path": "src/platform/admin/router.py",
      "description": "密钥轮换端点",
      "endpoints": [
        "POST /admin/keys/rotate"
      ]
    },
    {
      "name": "user-router",
      "path": "src/platform/admin/user_router.py",
      "description": "用户 CRUD + 审计日志",
      "endpoints": [
        "GET /admin/users",
        "POST /admin/users",
        "PUT /admin/users/{user_id}/password",
        "DELETE /admin/users/{user_id}"
      ]
    },
    {
      "name": "export",
      "path": "src/platform/admin/export.py",
      "description": "数据导出/导入（tar.gz）",
      "endpoints": [
        "POST /admin/data/export",
        "POST /admin/data/import"
      ]
    }
  ],
  "roles": [
    "admin",
    "reviewer",
    "viewer",
    "bid_editor"
  ],
  "security": {
    "password_hash": "passlib.bcrypt",
    "encryption": "AES-256-GCM, KEK+DEK",
    "role_guard": "Depends(require_role('admin'))",
    "second_factor": "二次密码确认（POST /auth/login 验证）",
    "audit": "AuditLog 模型，append-only，action 枚举：user_created|password_reset|user_deleted"
  },
  "frontend": {
    "file": "static/index.html",
    "panel_id": "adminPanel",
    "sub_panels": {
      "users": "adminUsersPanel",
      "config": "adminConfigPanel",
      "data": "adminDataPanel",
      "kb": "adminKbPanel"
    },
    "entry_function": "switchPanel('admin')",
    "sub_switch_function": "switchAdminSub(name)"
  },
  "approvals": {
    "requirements": true,
    "design": true,
    "tasks": true
  }
}