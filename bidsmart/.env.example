# BidSmart 环境变量配置 / Environment Configuration
# 复制此文件为 .env 并填入真实值 / Copy to .env and fill in real values

# DeepSeek API (必需 / Required)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 文件上传限制 / Upload Limits (MB)
MAX_UPLOAD_SIZE_MB=250

# 存储根目录 (可选，默认 ./storage)
# Storage root (optional, defaults to ./storage)
# STORAGE_ROOT=./storage

# 密钥加密密钥 (可选，生产环境必须设置)
# Key Encryption Key (optional, REQUIRED for production)
# BIDSMART_KEK=your-32-byte-kek-here
